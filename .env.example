# .env.example

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luma_salon

# Redis
REDIS_URL=redis://localhost:6379

# Webhooks / automação
N8N_WEBHOOK_URL=https://example.n8n.app/webhook/your-webhook
WEBHOOK_SECRET=change-me

# Security
ENCRYPTION_KEY=change-me-32-bytes-long

# NF-e / certificado digital
NFE_CERTIFICATE_PATH=/certs/certificate.pfx
NFE_CERTIFICATE_PASSWORD=change-me
NFE_ENVIRONMENT=homologacao

# Monitoring
SENTRY_DSN=
